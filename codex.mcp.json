{
  "mcpServers": {
    "text-to-reality": {
      "command": "uvx",
      "args": [
        "--no-config",
        "--managed-python",
        "--python",
        "3.13",
        "--from",
        "text-to-reality==0.1.1",
        "text-to-reality",
        "mcp"
      ],
      "env": {
        "TEXT_TO_REALITY_INSTALL_CHANNEL": "codex-github"
      },
      "startup_timeout_sec": 300
    }
  }
}
